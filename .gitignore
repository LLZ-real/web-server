# ---------- 运行期产物 ----------
# 上传的文件属于用户数据，不进版本库；保留 .gitkeep 维持目录结构
src/storage/*
!src/storage/.gitkeep

# 服务端日志与启动输出
*.log
server.out

# 访问码（含管理员码，绝不入库）
src/auth.json

